# Kopiera till .env.local och fyll i ur "npx supabase status -o env".
# .env.local committas aldrig.
#
# Portblocket är 5442x, inte Supabases standard 5432x. Skälet står i
# beslutsloggen B-014: hälsoappens lokala stack äger 5432x och ska kunna
# vara igång samtidigt.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY>

# Kringgår RLS. Endast för migrationer, frödata och prov — får aldrig nå klienten.
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>

# Databasen direkt, för prov som läser schemat
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres
