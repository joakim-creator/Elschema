# Kopiera till .env.local och fyll i. .env.local committas aldrig.
# Värdena nedan är den lokala Supabase-stackens standardnycklar och är
# avsiktligt publika — de gäller bara mot localhost.

# Supabase, lokal utveckling (npx supabase start skriver ut dessa)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-nyckel från "supabase start">

# Endast för prov och frödata. Kringgår RLS — får aldrig nå klienten.
SUPABASE_SERVICE_ROLE_KEY=<service_role-nyckel från "supabase start">

# Databasen direkt, för migrationer och prov
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
